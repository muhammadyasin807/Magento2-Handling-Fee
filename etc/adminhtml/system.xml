<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="doit_handling_fee"
                 translate="label"
                 sortOrder="950"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="0">

            <label>Doit Handling Fee</label>
            <tab>sales</tab>
            <resource>Doit_HandlingFee::config</resource>

            <group id="general"
                   translate="label"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="0">

                <label>General</label>

                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="amount"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Fee Amount</label>
                    <comment>Amount per eligible cart in the website base currency.</comment>
                    <validate>required-entry validate-number validate-zero-or-greater</validate>
                    <backend_model>Doit\HandlingFee\Model\Config\Backend\Amount</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

            </group>
        </section>
    </system>
</config>
